{
  "name": "xiaofeiyu-academy",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "小肥鱼学习平台：一只蓝色大肥鱼陪你闯关、改错题、攒星星的少儿学习舱。",
  "icon": "icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/*",
    "locale/*.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "安装说明.md",
    "docs/*.md",
    "docs/preview-*.png",
    "设计语言/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
